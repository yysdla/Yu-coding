# =============================================================================
# ProjectLens environment template
# Copy to `.env` and fill in secrets. Never commit real API keys or Feishu secrets.
# Full pilot profiles: docs/pilot-launch-config.md
# =============================================================================

PROJECT_LENS_ENV=development
PROJECT_LENS_LOG_LEVEL=INFO
PROJECT_LENS_API_PREFIX=/api/v1

# Persistent SQLite path for runs / events / conversations.
# Pilot / Feishu tests: use a real file path. Do NOT use ":memory:".
PROJECT_LENS_DATABASE_PATH=project_lens.db

# ConversationSession backend: sqlite (default, durable) | memory (tests only)
PROJECT_LENS_CONVERSATION_STORE=sqlite

# -----------------------------------------------------------------------------
# Model provider
# Defaults keep live network LLM off. In workflow mode, the model is still mostly
# expression/context preparation. In read_agent mode, ProjectInvestigationAgent can
# use a safe read-only tool loop through ProjectLens gateways.
# Do NOT enable Apply / PR / deploy / rollback / restart via env — those stay closed in code.
# -----------------------------------------------------------------------------
PROJECT_LENS_MODEL_PROVIDER=stub
PROJECT_LENS_MODEL_NAME=stub-v1
PROJECT_LENS_MODEL_TIMEOUT_SECONDS=30
PROJECT_LENS_MODEL_MAX_RETRIES=1
PROJECT_LENS_MODEL_MAX_TOKENS=2048
PROJECT_LENS_MODEL_TEMPERATURE=0.0

# Safe Live: both provider=openai AND live=true required for real network calls.
PROJECT_LENS_MODEL_LIVE=false
PROJECT_LENS_MODEL_FALLBACK_TO_STUB=true

# OpenAI-compatible provider (only when greying in Safe Live)
PROJECT_LENS_MODEL_OPENAI_BASE_URL=
PROJECT_LENS_MODEL_OPENAI_MODEL=gpt-4o-mini
PROJECT_LENS_MODEL_OPENAI_API_KEY=

# Reserved providers (not required for V0.1–V0.3 pilot)
PROJECT_LENS_MODEL_INTERNAL_ENDPOINT=
PROJECT_LENS_MODEL_LOCAL_PATH=

# -----------------------------------------------------------------------------
# Agent execution mode
# workflow   = legacy deterministic workflow + Skill/Specialist pipeline.
# read_agent = read-only ProjectInvestigationAgent; Feishu natural project
#              questions enter the tool loop and answer with citations.
# `/project ...` is only a debug/smoke entry; natural Feishu questions are the
# product entry in both modes.
# -----------------------------------------------------------------------------
PROJECT_LENS_AGENT_MODE=workflow

# -----------------------------------------------------------------------------
# Feishu callback + outbound API
# Leave APP_ID / APP_SECRET blank to use the local recording messenger.
# -----------------------------------------------------------------------------
PROJECT_LENS_FEISHU_VERIFICATION_TOKEN=replace-me
PROJECT_LENS_FEISHU_SIGNING_SECRET=
PROJECT_LENS_FEISHU_APP_ID=
PROJECT_LENS_FEISHU_APP_SECRET=
PROJECT_LENS_FEISHU_API_BASE_URL=https://open.feishu.cn

# Optional Feishu document sync ops (default off; does not affect chat paths)
PROJECT_LENS_FEISHU_DOC_SYNC_ON_STARTUP=false
PROJECT_LENS_FEISHU_DOC_SYNC_INTERVAL_SECONDS=0

# -----------------------------------------------------------------------------
# Local project registry (demo payment_service)
# Paths can be absolute or relative to the ProjectLens project root.
# -----------------------------------------------------------------------------
PROJECT_LENS_LOCAL_PROJECT_REGISTRY={"projects":[{"tenant_id":"demo","project_id":"payment","service":"order-service","environment":"production","repository_root":"examples/payment_service/src","documents_root":"examples/payment_service/knowledge","incidents_file":"examples/payment_service/knowledge/incidents.json","git_log_file":"examples/payment_service/fixtures/git_log.txt","git_branch":"main","feishu_documents_file":"examples/payment_service/knowledge/feishu_docs.json","feishu_doc_tokens":["docx_payment_owners"],"tasks_file":"examples/payment_service/knowledge/tasks.json","releases_file":"examples/payment_service/knowledge/releases.json","dependencies_file":"examples/payment_service/knowledge/dependencies.json","ops_signals_file":"examples/payment_service/fixtures/ops_signals.json","access_scope":"project:payment:read"}]}

# JSON binding between Feishu tenant/chat and a registered ProjectLens project.
# A binding must identify exactly one registered project. Optional allowed_users limits who can ask.
PROJECT_LENS_FEISHU_PROJECT_BINDINGS={"bindings":[{"tenant_key":"tenant-key","chat_id":"oc_xxx","project_id":"payment","service":"order-service","environment":"production"}]}
